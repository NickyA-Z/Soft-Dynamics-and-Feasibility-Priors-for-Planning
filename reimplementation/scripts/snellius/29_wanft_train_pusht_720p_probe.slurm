#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=dl2_wanft_pusht720_probe
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=180G
#SBATCH --time=00:59:00
#SBATCH --output=logs/%x_%j.out

set -euo pipefail

RUNTIME_DIR="${DL2RUNTIME_ROOT:-${SLURM_SUBMIT_DIR}}"
source "${RUNTIME_DIR}/env.sh"

export WANFT_TASK="${WANFT_TASK:-pusht}"
export RAW_HORIZON="${RAW_HORIZON:-25}"
export WANFT_NUM_DEMOS="${WANFT_NUM_DEMOS:-100}"
export WANFT_NUM_FRAMES="${WANFT_NUM_FRAMES:-81}"
export WANFT_TRAIN_WIDTH="${WANFT_TRAIN_WIDTH:-1280}"
export WANFT_TRAIN_HEIGHT="${WANFT_TRAIN_HEIGHT:-720}"
export WANFT_CLIP_MODE="${WANFT_CLIP_MODE:-prefix}"
export WANFT_SEGMENTS_PER_DEMO="${WANFT_SEGMENTS_PER_DEMO:-1}"
export WANFT_RESAMPLE_MODE="${WANFT_RESAMPLE_MODE:-nearest}"
export WANFT_DATASET_ROOT="${WANFT_DATASET_ROOT:-${DL2RUNTIME_ROOT}/data/wanft_pusht_t25_100d_prefix_1s_81f_1280x720}"
export WANFT_OUTPUT_DIR="${WANFT_OUTPUT_DIR:-${DL2RUNTIME_ROOT}/models/wanft_pusht_t25_paper_100d_81f_1280x720_1h_probe}"
export WANFT_DATASET_REPEAT="${WANFT_DATASET_REPEAT:-10}"
export WANFT_EPOCHS="${WANFT_EPOCHS:-10}"
export WANFT_LEARNING_RATE="${WANFT_LEARNING_RATE:-1e-5}"
export WANFT_LORA_RANK="${WANFT_LORA_RANK:-32}"
export WANFT_SAVE_STEPS="${WANFT_SAVE_STEPS:-5}"
export WANFT_DATASET_NUM_WORKERS="${WANFT_DATASET_NUM_WORKERS:-2}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"

bash "${RUNTIME_DIR}/jobs/24_wanft_train_t25.slurm"
