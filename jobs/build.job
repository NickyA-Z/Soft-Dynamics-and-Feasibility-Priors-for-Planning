#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=build_train_0_499
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=2:00:00
#SBATCH --output=/home/nvzutphen/logs/build_train_0_499_%j.out
#SBATCH --error=/home/nvzutphen/logs/build_train_0_499_%j.err

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

export CONDA_PREFIX="$HOME/.conda/envs/dl2_full"
export PATH="$CONDA_PREFIX/bin:$PATH"

cd "$HOME"

export PYTHON="$CONDA_PREFIX/bin/python"
export OUTDIR="$HOME/data"
export OUTFILE="$OUTDIR/feasibility_train_pusht_0_499.pt"
export PYTHONPATH="$HOME:$HOME/dino_wm:${PYTHONPATH:-}"
export WANDB_MODE=disabled

mkdir -p "$OUTDIR"

echo "Building train set (episodes 0-499)..."
echo "CONDA_PREFIX=$CONDA_PREFIX"
echo "Python: $PYTHON"
echo "which python: $(which python)"
$PYTHON -c "import sys; print(sys.executable)"
$PYTHON -c "import psutil, wandb, submitit, gym, hydra; print('core imports ok')"
echo "Output directory: $OUTDIR"
echo "Output file: $OUTFILE"
echo "Working directory: $(pwd)"
echo "PYTHONPATH=$PYTHONPATH"

$PYTHON -u -m extension.feasibility2.build \
  --episode-start 0 \
  --episode-end 500 \
  --domain pusht \
  --out "$OUTFILE"