#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=build_test_500_599
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=2:00:00
#SBATCH --output=/home/nvzutphen/logs/build_test_500_599_%j.out
#SBATCH --error=/home/nvzutphen/logs/build_test_500_599_%j.err

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

export CONDA_PREFIX="$HOME/.conda/envs/dl2_full"
export PATH="$CONDA_PREFIX/bin:$PATH"

cd "$HOME"

export PYTHON="$CONDA_PREFIX/bin/python"
export OUTDIR="$HOME/data"
export TRAIN_STATS="$OUTDIR/feasibility_train_pusht_0_499.pt"
export OUTFILE="$OUTDIR/feasibility_test_pusht_500_599.pt"
export PYTHONPATH="$HOME:$HOME/dino_wm:${PYTHONPATH:-}"
export WANDB_MODE=disabled

mkdir -p "$OUTDIR"

echo "Building test set (episodes 500-599) using train stats..."
echo "CONDA_PREFIX=$CONDA_PREFIX"
echo "Python: $PYTHON"
echo "which python: $(which python)"
$PYTHON -c "import sys; print(sys.executable)"
$PYTHON -c "import psutil, wandb, submitit, gym, hydra; print('core imports ok')"
echo "Train stats file: $TRAIN_STATS"
echo "Output file: $OUTFILE"
echo "Working directory: $(pwd)"
echo "PYTHONPATH=$PYTHONPATH"

test -f "$TRAIN_STATS"

$PYTHON -u -m extension.feasibility2.build \
  --episode-start 500 \
  --episode-end 600 \
  --domain pusht \
  --out "$OUTFILE" \
  --norm-stats "$TRAIN_STATS"