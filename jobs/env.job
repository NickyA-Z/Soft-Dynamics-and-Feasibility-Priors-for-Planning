#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=InstallEnvironment
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:05:00
#SBATCH --output=slurm_output_%A.out

set -euo pipefail



module purge
module load 2025
module load Anaconda3/2025.06-1

export PYTHONNOUSERSITE=1

source "$(conda info --base)/etc/profile.d/conda.sh"

echo "Using conda: $(which conda)"
echo "Using env file: /home/nvzutphen/env.yml"

# Remove broken/incomplete env if it exists
if conda env list | awk '{print $1}' | grep -qx "dl2_full"; then
    echo "Removing existing dl2_full"
    conda env remove -n dl2_full -y
fi

conda env create -f /home/nvzutphen/env.yml
conda activate dl2_new

export PYTHONNOUSERSITE=1

which python
python --version
python -c "import sys; print(sys.executable)"
python -c "import wandb; print(wandb.__version__)"
python -c "import decord; print('decord ok')"