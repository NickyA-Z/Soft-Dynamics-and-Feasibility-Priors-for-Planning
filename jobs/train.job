#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=train_feas_pusht
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=02:00:00
#SBATCH --output=/home/nvzutphen/logs/train_feas_pusht_%j.out
#SBATCH --error=/home/nvzutphen/logs/train_feas_pusht_%j.err

set -euo pipefail

cd "$HOME"

mkdir -p logs
mkdir -p checkpoints/feasibility_pusht

module purge
module load 2025
module load Anaconda3/2025.06-1

export CONDA_PREFIX="$HOME/.conda/envs/dl2_new"
export PATH="$CONDA_PREFIX/bin:$PATH"
export PYTHONPATH="$HOME:$HOME/dino_wm:${PYTHONPATH:-}"

PYTHON="$CONDA_PREFIX/bin/python"

DATAPATH="$HOME/data/feasibility_train_pusht_0_499.pt"
CKPT="$HOME/checkpoints/feasibility_pusht/plain_dsm_full.pt"

echo "===== Environment ====="
echo "Host: $(hostname)"
echo "Working directory: $(pwd)"
echo "Python: $PYTHON"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-unset}"

echo
echo "===== GPU allocation ====="
nvidia-smi

echo
echo "===== PyTorch CUDA check ====="
"$PYTHON" - <<'PY'
import sys
import torch

print("PyTorch:", torch.__version__)
print("PyTorch CUDA build:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
print("GPU count:", torch.cuda.device_count())

if not torch.cuda.is_available():
    sys.exit("ERROR: CUDA unavailable; refusing to train on CPU.")

print("GPU:", torch.cuda.get_device_name(0))
PY

echo
echo "===== Training ====="
echo "Dataset: $DATAPATH"
echo "Checkpoint: $CKPT"

"$PYTHON" -u -m extension.feasibility2.train \
    --dataset "$DATAPATH" \
    --checkpoint-out "$CKPT" \
    --epochs 150 \
    --batch-size 64 \
    --lr 1e-4 \
    --model-dim 256 \
    --num-layers 4 \
    --num-heads 4 \
    --sigma-min 0.05 \
    --sigma-max 0.5 \
    --noise-level 0.05 \
    --lambda-delta 0 \
    --lambda-contrastive 0.0 \
    --val-fraction 0.1 \
    --max-val-samples 0 \
    --num-workers 2 \
    --weight-decay 0.0 \
    --val-fraction 0.1 \
    --device cuda