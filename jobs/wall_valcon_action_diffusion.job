#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=wall_valcon_act
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=08:00:00
#SBATCH --output=/home/nvzutphen/logs/wall/wall_valcon_action_%j.out
#SBATCH --error=/home/nvzutphen/logs/wall/wall_valcon_action_%j.err

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

PYTHON="$HOME/.conda/envs/dl2_dino/bin/python"
PROJECT_DIR="$HOME"
TRAIN_DATASET="$HOME/data/feasibility_wall_train.pt"
CHECKPOINT_OUT="$HOME/checkpoints/feasibility_wall/wall_valcon_action_diffusion.pt"

mkdir -p "$HOME/logs/wall"
mkdir -p "$HOME/checkpoints/feasibility_wall"

for required in "$PYTHON" "$TRAIN_DATASET"; do
    if [[ ! -e "$required" ]]; then
        echo "ERROR: required path not found: $required" >&2
        exit 1
    fi
done

if [[ ! -d "$PROJECT_DIR/extension/feasibility2" ]]; then
    echo "ERROR: feasibility2 package not found under $PROJECT_DIR/extension" >&2
    exit 1
fi

cd "$PROJECT_DIR"
export PYTHONPATH="$PROJECT_DIR:$PROJECT_DIR/reimplementation:$PROJECT_DIR/dino_wm:${PYTHONPATH:-}"

echo "===== Validate Wall feasibility dataset ====="
"$PYTHON" - "$TRAIN_DATASET" <<'PY'
import sys
import torch

path = sys.argv[1]
artifact = torch.load(path, map_location="cpu", weights_only=False)

if artifact.get("domain") != "wall_single":
    raise RuntimeError(
        f"Expected domain='wall_single', got {artifact.get('domain')!r}"
    )

required = (
    "histories",
    "actions",
    "next_latents",
    "past_action_histories",
    "latent_mean",
    "latent_std",
)
missing = [name for name in required if name not in artifact]
if missing:
    raise RuntimeError(f"Dataset is missing required fields: {missing}")

print("Dataset:", path)
print("Domain:", artifact["domain"])
print("Histories:", tuple(artifact["histories"].shape))
print("Actions:", tuple(artifact["actions"].shape))
print("Next latents:", tuple(artifact["next_latents"].shape))
print("Past actions:", tuple(artifact["past_action_histories"].shape))
print("Episodes:", artifact.get("episode_start"), artifact.get("episode_end"))
PY

echo
echo "===== Wall ValCon plus action-diffusion training ====="
echo "Host:       $(hostname)"
echo "Job ID:     ${SLURM_JOB_ID:-not-set}"
echo "Dataset:    $TRAIN_DATASET"
echo "Checkpoint: $CHECKPOINT_OUT"

nvidia-smi

"$PYTHON" -u -m extension.feasibility2.train \
    --dataset "$TRAIN_DATASET" \
    --checkpoint-out "$CHECKPOINT_OUT" \
    --epochs 50 \
    --batch-size 32 \
    --lr 1e-4 \
    --weight-decay 0.0 \
    --model-dim 256 \
    --num-heads 4 \
    --num-layers 4 \
    --sigma-min 0.05 \
    --sigma-max 0.5 \
    --noise-level 0.05 \
    --lambda-latent-dsm 1.0 \
    --lambda-action-dsm 1.0 \
    --lambda-delta 1.0 \
    --delta-target-mode current_delta \
    --lambda-contrastive 1.0 \
    --lambda-hard-negative 0.0 \
    --contrastive-margin 0.2 \
    --contrastive-temperature 0.1 \
    --contrastive-noise-level 0.0 \
    --contrastive-hard-weight 1.0 \
    --contrastive-calibration-margin 1.0 \
    --contrastive-calibration-weight 0.1 \
    --contrastive-num-action-shuffles 2 \
    --contrastive-fraction 0.5 \
    --contrastive-every 1 \
    --contrastive-val-batches 4 \
    --contrastive-val-every 5 \
    --val-fraction 0.1 \
    --max-val-samples 0 \
    --num-workers 8 \
    --device cuda \
    --contrastive-latent-noise-scales

echo "===== Training complete ====="
echo "Use validation-selected checkpoint: $CHECKPOINT_OUT"
echo "Final-epoch checkpoint: ${CHECKPOINT_OUT%.pt}_final.pt"
