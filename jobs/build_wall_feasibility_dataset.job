#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=build_wall_feas
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=96G
#SBATCH --time=04:00:00
#SBATCH --output=/home/nvzutphen/logs/wall/build_wall_feas_%j.out
#SBATCH --error=/home/nvzutphen/logs/wall/build_wall_feas_%j.err

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

PYTHON="$HOME/.conda/envs/dl2_dino/bin/python"
PROJECT_DIR="$HOME"
DINO_WM_ROOT="$PROJECT_DIR/dino_wm"
WALL_DATA_ROOT="$DINO_WM_ROOT/data/wall_single"
OUTDIR="$HOME/data"
TRAIN_OUT="$OUTDIR/feasibility_wall_train.pt"
VAL_OUT="$OUTDIR/feasibility_wall_val.pt"

mkdir -p "$HOME/logs/wall"
mkdir -p "$OUTDIR"

for required in \
    "$PYTHON" \
    "$WALL_DATA_ROOT/states.pth" \
    "$WALL_DATA_ROOT/actions.pth" \
    "$WALL_DATA_ROOT/door_locations.pth" \
    "$WALL_DATA_ROOT/wall_locations.pth" \
    "$WALL_DATA_ROOT/obses/episode_000.pth" \
    "$DINO_WM_ROOT/checkpoints/outputs/wall_single/hydra.yaml" \
    "$DINO_WM_ROOT/checkpoints/outputs/wall_single/checkpoints/model_latest.pth"
do
    if [[ ! -e "$required" ]]; then
        echo "ERROR: required path not found: $required" >&2
        exit 1
    fi
done

for output in "$TRAIN_OUT" "$VAL_OUT"; do
    if [[ -e "$output" ]]; then
        echo "ERROR: refusing to overwrite existing dataset: $output" >&2
        exit 1
    fi
done

cd "$PROJECT_DIR"
export DINO_WM_ROOT
export PYTHONPATH="$PROJECT_DIR:$PROJECT_DIR/reimplementation:$DINO_WM_ROOT:${PYTHONPATH:-}"
export PYTHONDONTWRITEBYTECODE=1

EPISODE_COUNT="$($PYTHON - "$WALL_DATA_ROOT/states.pth" <<'PY'
import sys
import torch

states = torch.load(sys.argv[1], map_location="cpu", weights_only=False)
if states.ndim < 2:
    raise RuntimeError(f"Unexpected states shape: {tuple(states.shape)}")
print(int(states.shape[0]))
PY
)"

if [[ ! "$EPISODE_COUNT" =~ ^[0-9]+$ ]] || (( EPISODE_COUNT < 10 )); then
    echo "ERROR: invalid or insufficient episode count: $EPISODE_COUNT" >&2
    exit 1
fi

TRAIN_END=$((EPISODE_COUNT * 80 / 100))
VAL_END=$((EPISODE_COUNT * 90 / 100))

if (( TRAIN_END < 1 || VAL_END <= TRAIN_END || VAL_END >= EPISODE_COUNT )); then
    echo "ERROR: invalid split boundaries for $EPISODE_COUNT episodes" >&2
    exit 1
fi

echo "===== Build Wall feasibility datasets ====="
echo "Host:              $(hostname)"
echo "Job ID:            ${SLURM_JOB_ID:-not-set}"
echo "Wall episodes:     $EPISODE_COUNT"
echo "Training range:    [0, $TRAIN_END)"
echo "Validation range:  [$TRAIN_END, $VAL_END)"
echo "Reserved test:     [$VAL_END, $EPISODE_COUNT)"
echo "Training artifact: $TRAIN_OUT"
echo "Validation output: $VAL_OUT"

nvidia-smi

"$PYTHON" -u -m extension.wall_feasibility.build_wall \
    --episode-start 0 \
    --episode-end "$TRAIN_END" \
    --data-root "$WALL_DATA_ROOT" \
    --out "$TRAIN_OUT"

"$PYTHON" -u -m extension.wall_feasibility.build_wall \
    --episode-start "$TRAIN_END" \
    --episode-end "$VAL_END" \
    --data-root "$WALL_DATA_ROOT" \
    --norm-stats "$TRAIN_OUT" \
    --out "$VAL_OUT"

echo "===== Dataset construction complete ====="
echo "Train with: sbatch jobs/wall_valcon.job"
